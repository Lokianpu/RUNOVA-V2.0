<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navigationBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/navbg"
    android:padding="25dp"
    android:elevation="8dp">

    <ImageButton
        android:id="@+id/homeb"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="homeb"
        android:paddingTop="5dp"
        android:layout_weight="1"
        android:src="@drawable/homeb" />

    <ImageButton
        android:id="@+id/analyticsb"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="analyticsb"
        android:paddingTop="5dp"
        android:layout_weight="1"
        android:src="@drawable/analyticsb" />

    <ImageButton
        android:id="@+id/targetb"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="targetb"
        android:paddingTop="5dp"
        android:layout_weight="1"
        android:src="@drawable/targetb" />

    <ImageButton
        android:id="@+id/profileb"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="profileb"
        android:paddingTop="5dp"
        android:layout_weight="1"
        android:src="@drawable/profileb" />

</LinearLayout>
