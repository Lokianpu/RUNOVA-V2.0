<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RUNOVA">
        <activity
            android:name="com.runova.SignupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.runova.QuestionnaireActivity"
            android:exported="false" />
        <activity
            android:name="com.runova.HomeActivity"
            android:exported="false" />
        <activity
            android:name="com.runova.TargetActivity"
            android:exported="false" />
        <activity
            android:name="com.runova.AnalyticsActivity"
            android:exported="false" />
        <activity
            android:name="com.runova.ProfileActivity"
            android:exported="false" />
        <activity
            android:name="com.runova.NotificationsActivity"
            android:exported="false" />
        <activity
            android:name="com.runova.SettingsActivity"
            android:exported="false" />
        <activity
            android:name="com.runova.LoadingActivity"
            android:exported="false" />
        <activity
            android:name="com.runova.TimerActivity"
            android:exported="false" />
        <activity
            android:name="com.runova.TrainingContentActivity"
            android:exported="false" />
    </application>

</manifest>